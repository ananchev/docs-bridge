# Secrets — never commit
**/vault.yml
**/*.vault
.env
*.env
**/group_vars/**/vault.yml
*.key
*.pem
id_rsa*
id_ed25519*
authorized_keys

# OS images / large binaries — do not version
*.img
*.img.xz
*.img.gz
*.iso
*.zip

# Ansible noise
*.retry
.ansible/
*.log

# Python / tooling
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/

# Python build artifacts
*.egg-info/

# Phase A raw run output: bulky logs and vector dumps stay on vhost2 / local only;
# the small summaries (*.txt verdicts, analysis) are committed.
notes/phase-a/embed-*.json
notes/phase-a/6-rebuild-*.txt
notes/phase-a/*-ingest.txt
notes/phase-a/5-whats-new.txt
notes/phase-a/3-smoke-chunks.json
notes/phase-a/1-build-*.log
