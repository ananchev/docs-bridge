# Build context is the REPO ROOT for ingest-worker, docs-bridge, embedder and models-export,
# so keep it lean — the Dockerfiles only COPY pyproject.toml, src/, the locks.
.git/
**/__pycache__/
**/*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.DS_Store
*.md
images/
# ...except the dependency locks the Dockerfiles install (images/lock.sh)
!images/ingest-worker/requirements-*.lock
!images/embedder/requirements.lock
!images/docs-bridge/requirements-*.lock
!images/models-export/requirements.lock
provisioning/
application_data/
*.sh
config.example.yaml
